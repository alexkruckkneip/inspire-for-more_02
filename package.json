{
  "name": "inspire-for-more--Q1-26",
  "version": "1.0.0",
  "description": "NPM modules to create the Q1 2026 version of the portfolio page 'Inspire for more' using my own custom front end web framework",
  "main": "html/index.js",
  "devDependencies": {
    "@compodoc/live-server": "^1.2.3",
    "browser-sync": "^3.0.3",
    "npm-run-all": "^4.1.5",
    "sass": "^1.83.4"
  },
  "scripts": {
    "watch:sass": "sass --watch sass/custom.scss:html/assets/css/style.css",
    "devserver": "live-server --browser=CHROME --open=html/index.html",
    "start": "npm-run-all --parallel devserver watch:sass"
  },
  "author": "Alexander Kruck",
  "license": "ISC"
}
